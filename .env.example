# Server-side only — never expose these to the client (no NEXT_PUBLIC_ prefix).
# Set real values in Vercel project settings / .env.local. Not used yet: the app
# currently runs on an in-memory store until Supabase credentials are provided.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Places API (New) key, for run club address search. Restrict the key to
# the Places API and set a daily quota cap in the Cloud console. The UI never
# sees this — the browser calls /api/places, which proxies Google server-side.
# Address search is disabled (503) when this is unset; clubs can still be
# created by filling in city and country manually.
GOOGLE_PLACES_API_KEY=

# Credentials for a throwaway Supabase Auth user, used only by
# `node scripts/test-login.mjs` to exercise the login flow locally. Local /
# CI only — never a real account, never set in the Vercel project.
TEST_USER_NAME=
TEST_USER_PASSWORD=
