# Server-side only — never expose these to the client (no NEXT_PUBLIC_ prefix).
# Set real values in Vercel project settings / .env.local.

# --- Database (Prisma) ------------------------------------------------------
# Postgres connection strings from Supabase → Project Settings → Database →
# Connection string. DATABASE_URL is what the app queries through, so use the
# *transaction pooler* (port 6543) on serverless; DIRECT_URL is the session /
# direct connection (port 5432) that migrations need, since they cannot run
# through a transaction pooler.
DATABASE_URL=
DIRECT_URL=

# Postgres schema this environment owns — rt_local for development, rt_prod
# in production. Required, and it must never be "public": this database is
# shared with other projects whose tables live there, including their own
# `races` and `users`. The db:* scripts create the schema if it is missing.
DB_SCHEMA=rt_local

# --- Supabase Auth ----------------------------------------------------------
# Still used for authentication (sessions, sign-up, the admin user list).
# Database access no longer goes through these — that is Prisma's job.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Places ----------------------------------------------------------
# Google Places API (New) key, for run club address search. Restrict the key to
# the Places API and set a daily quota cap in the Cloud console. The UI never
# sees this — the browser calls /api/places, which proxies Google server-side.
# Address search is disabled (503) when this is unset; clubs can still be
# created by filling in city and country manually.
GOOGLE_PLACES_API_KEY=

# --- Test account -----------------------------------------------------------
# Credentials for a throwaway Supabase Auth user, used only by
# `node scripts/test-login.mjs` to exercise the login flow locally. Local /
# CI only — never a real account, never set in the Vercel project.
TEST_USER_NAME=
TEST_USER_PASSWORD=
