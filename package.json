{
  "name": "race-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:login": "node scripts/test-login.mjs",
    "postinstall": "prisma generate",
    "db:ensure-schema": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-ensure-schema.mjs",
    "db:migrate": "npm run db:ensure-schema -- --shadow && prisma migrate dev",
    "db:deploy": "npm run db:ensure-schema && prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:reset": "npm run db:ensure-schema -- --shadow && prisma migrate reset",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.110.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "countries-list": "^3.4.1",
    "lucide-react": "^1.25.0",
    "next": "^15.4.2",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.14.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3"
  }
}
